{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jefflin-dev",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "jxlin.dev", "custom_domain": true }
  ],
  "workers_dev": true,
  "triggers": {
    "crons": ["*/10 * * * *", "0 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "17e2378c371d428389eda82c7b8d0c4e",
      "preview_id": "8c7a7d07d6f94180b5b490f6093b59cc",
      "remote": true
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "ANALYTICS",
      "dataset": "jxlin_pageviews"
    }
  ]
}
